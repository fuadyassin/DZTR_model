# These scientific inputs and reference fixtures carry SHA256 byte identities.
# Preserve their stored line endings across operating systems and Git settings.
data/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
configs/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
tests/reference_cases/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol

# Portable example inputs and curated assessment receipts also carry byte hashes.
examples/portable/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/assets/researcher_v1/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol

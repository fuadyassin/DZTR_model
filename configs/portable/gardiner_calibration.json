{
  "kind": "dztr_run_manager_v8",
  "schema_version": 8,
  "description": "Optional new joint calibration from public Gardiner observations. Plan is read-only; run launches up to 1536 NSGA-II evaluations. Use --until baseline to stop before optimization.",
  "stages": [
    {
      "id": "targets",
      "type": "parameterize",
      "config": {
        "kind": "dztr_data_availability_v1",
        "schema_version": 1,
        "methods": ["observed_monthly"],
        "quantile_method": "hazen",
        "channel_policy": "source_defined",
        "year_selection": {"minimum_fraction": 0.65, "seed": 42, "water_year_start_month": 1, "warmup_years": 1},
        "reservoirs": [{
          "reservoir_id": "ex14_Gardiner", "name": "Gardiner", "GRAND_ID": 253,
          "observations_csv": "../../data/reservoirs/ex14_Gardiner/observations_si.csv",
          "model_config": "../run_manager/gardiner_model_v1.json",
          "forcing_stage": "canonical", "source_gates": []
        }]
      }
    },
    {"id": "baseline", "type": "baseline", "config": {"campaign": "@targets.campaign"}},
    {
      "id": "calibration", "type": "calibrate", "backend": "prepared_v1",
      "config": {
        "kind": "dztr_prepared_calibration_v1", "schema_version": 1,
        "campaign": "@targets.campaign",
        "profiles": [{"reservoir_id": "ex14_Gardiner", "method": "observed_monthly"}],
        "scoring": "pooled",
        "optimization": {"seeds": [42, 43, 44], "population": 32, "evaluation_budget": 512, "workers": 3}
      }
    }
  ]
}

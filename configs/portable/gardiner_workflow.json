{
  "kind": "dztr_run_manager_v8",
  "schema_version": 8,
  "description": "Public local-input demonstration: frozen mixed-year selection, observed and flow-only target estimation, fixed baselines. Zero optimization evaluations.",
  "stages": [
    {
      "id": "targets",
      "type": "parameterize",
      "config": {
        "kind": "dztr_data_availability_v1",
        "schema_version": 1,
        "methods": ["observed_monthly", "flow_only"],
        "quantile_method": "hazen",
        "channel_policy": "source_defined",
        "year_selection": {"minimum_fraction": 0.65, "seed": 42, "water_year_start_month": 1, "warmup_years": 1},
        "reservoirs": [{
          "reservoir_id": "ex14_Gardiner",
          "name": "Gardiner",
          "GRAND_ID": 253,
          "observations_csv": "../../data/reservoirs/ex14_Gardiner/observations_si.csv",
          "model_config": "../run_manager/gardiner_model_v1.json",
          "forcing_stage": "canonical",
          "source_gates": []
        }]
      }
    },
    {"id": "baseline", "type": "baseline", "config": {"campaign": "@targets.campaign"}}
  ]
}
